{
  "name": "forge-learning",
  "version": "0.1.0",
  "private": true,
  "description": "Forge Learning mobile shell",
  "scripts": {
    "mobile:build": "node scripts/build-mobile-web.js",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run mobile:build && cap sync",
    "cap:copy": "npm run mobile:build && cap copy",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "staging": "node dev/staging-server.js",
    "check:content-status": "node scripts/build-content-status.js --check",
    "check:buttons": "node scripts/check-button-types.js",
    "check": "node scripts/build-content-status.js --check && node scripts/check-button-types.js && node scripts/check-routes.js && node dev/test-forge.js && node dev/test-auth.js && node dev/test-forge-api.js && node dev/test-persistence.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/local-notifications": "^7.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.9.3"
  }
}
